// Firebase Firestore Security Rules
// Para: c:\Users\josef\financias-app\firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - só owner pode ler/escrever
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow create: if request.auth.uid == userId &&
        request.resource.data.subscription == 'free';
      // Plano e Stripe só via Cloud Functions / Admin (webhooks)
      allow update: if request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscription', 'stripeCustomerId', 'stripeSubscriptionId', 'subscriptionStatus'
        ]);
      allow delete: if false; // Nunca deletar user
      
      // Subcollections
      match /transactions/{document=**} {
        allow read, write: if request.auth.uid == userId;
        allow delete: if request.auth.uid == userId;
      }
      
      match /recurring/{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
      
      match /featureUsage/{document=**} {
        allow read: if request.auth.uid == userId;
        allow create: if request.auth.uid == userId;
      }
    }
    
    // Subscriptions - controlo rígido
    match /subscriptions/{subscriptionId} {
      // Só ler se for o owner da subscription
      allow read: if request.auth.uid == resource.data.userId;
      
      // Permitir que Cloud Functions/Admin SDK crie
      // (em produção, use apenas através de Stripe webhook)
      allow create: if false;
      
      // Permitir update apenas para fields específicos
      allow update: if request.auth.uid == resource.data.userId &&
                       request.resource.data.keys().hasOnly(['status', 'renewalDate', 'features']) &&
                       resource.data.keys().hasOnly(['userId', 'plan', 'status', 'startDate', 'renewalDate', 
                                                      'price', 'billingCycle', 'invoiceScansLimit', 'features', 
                                                      'paymentInfo', 'createdAt', 'upgradedAt', 'cancelledAt']);
      
      // Nunca deletar (apenas cancel/downgrade)
      allow delete: if false;
    }
    
    // Invoice images - só owner pode ler/escrever
    match /invoices/{userId}/{allPaths=**} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
    }
    
    // Public collections (se houver)
    match /pricing/{document=**} {
      allow read: if true; // Plans públicos
      allow write: if false;
    }
  }
}
